<!--
  vision-arm-rl: brazo de 4 articulaciones + cubo rojo + zona objetivo verde + cámaras.

  Unidades SI: metros, kilogramos, segundos, radianes.
  Ejes del mundo: +x hacia delante del robot, +y a su izquierda, +z hacia arriba.
  El robot está en el origen; la zona de trabajo está entre x = 0.15 y 0.40 m.
-->
<mujoco model="vision_arm">
  <compiler angle="radian" autolimits="true"/>

  <!-- Física: un paso de 2 ms (500 Hz). La política decidirá cada N pasos (frame skip). -->
  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <!-- Tamaño máximo de las imágenes que puede sacar mujoco.Renderer -->
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.5 0.5 0.5" specular="0.1 0.1 0.1"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.30 0.42 0.60" rgb2="0.05 0.07 0.12" width="512" height="512"/>
    <texture name="checker" type="2d" builtin="checker" rgb1="0.32 0.34 0.38" rgb2="0.26 0.28 0.31" width="512" height="512"/>
    <material name="floor"  texture="checker" texrepeat="12 12" reflectance="0.15"/>
    <material name="link"   rgba="0.85 0.87 0.90 1" specular="0.6" shininess="0.6"/>
    <material name="dark"   rgba="0.15 0.16 0.18 1"/>
    <material name="accent" rgba="1.00 0.55 0.10 1"/>
    <!-- Colores puros y opacos: así la detección por color (fase 4) es fácil -->
    <material name="cube"   rgba="0.90 0.08 0.08 1"/>
    <material name="goal"   rgba="0.15 0.85 0.25 1"/>
  </asset>

  <default>
    <geom friction="1.0 0.005 0.0001" condim="3"/>

    <!-- Clase "arm": la usan todos los bodies del brazo (childclass en la base) -->
    <default class="arm">
      <!-- damping frena el movimiento (evita vibraciones); armature añade inercia al motor -->
      <joint type="hinge" damping="2.0" armature="0.05"/>
      <!-- Servo de posición: par = kp·(objetivo − ángulo), limitado a ±15 N·m -->
      <position kp="60" forcerange="-15 15"/>
    </default>

    <!-- Geoms solo decorativos: se dibujan pero no chocan con nada -->
    <default class="visual">
      <geom contype="0" conaffinity="0"/>
    </default>
  </default>

  <worldbody>
    <light name="key" pos="0.6 -0.6 1.6" dir="-0.4 0.4 -1" diffuse="0.7 0.7 0.7" castshadow="true"/>
    <geom name="floor" type="plane" size="2 2 0.1" material="floor"/>

    <!-- Punto invisible al que miran las cámaras en ángulo (centro de la zona de trabajo) -->
    <body name="focus" pos="0.27 0 0.05"/>

    <!-- ============================ CÁMARAS ============================ -->
    <!-- Cámara cenital: la "vista del robot" que usará el módulo de visión.
         Las cámaras de MuJoCo miran hacia su propio −z. Con estos xyaxes:
           eje x de la imagen (derecha) = −y del mundo
           eje y de la imagen (arriba)  = +x del mundo  (lo que está delante del robot sale arriba)
         y por tanto la cámara mira hacia −z del mundo, es decir, hacia abajo. -->
    <camera name="overhead" pos="0.27 0 0.90" xyaxes="0 -1 0 1 0 0" fovy="45"/>

    <!-- Cámaras para los vídeos: posición fija, orientación siempre hacia "focus" -->
    <camera name="showcase" pos="0.80 -0.70 0.55" mode="targetbody" target="focus" fovy="45"/>
    <camera name="front"    pos="0.95  0.00 0.35" mode="targetbody" target="focus" fovy="45"/>

    <!-- ============================= ROBOT ============================= -->
    <!-- Cadena: base → turret (yaw) → upper_arm (hombro) → forearm (codo) → wrist (muñeca).
         Cada joint une su body con el body padre. -->
    <body name="base" pos="0 0 0" childclass="arm">
      <geom type="cylinder" size="0.07 0.025" pos="0 0 0.025" material="dark"/>

      <!-- Giro de la base alrededor del eje vertical -->
      <body name="turret" pos="0 0 0.05">
        <joint name="yaw" axis="0 0 1" range="-2.0 2.0"/>
        <geom type="cylinder" size="0.04 0.06" pos="0 0 0.06" material="link"/>

        <!-- Hombro a 17 cm del suelo. Con ángulo 0 el brazo queda horizontal hacia +x.
             Eje +y y regla de la mano derecha: ángulo positivo = el brazo baja. -->
        <body name="upper_arm" pos="0 0 0.12">
          <joint name="shoulder" axis="0 1 0" range="-1.6 1.6"/>
          <geom type="cylinder" size="0.03 0.035" euler="1.5708 0 0" class="visual" material="accent"/>
          <geom type="capsule" fromto="0 0 0 0.20 0 0" size="0.022" material="link"/>

          <!-- Codo, al final del primer eslabón (20 cm) -->
          <body name="forearm" pos="0.20 0 0">
            <joint name="elbow" axis="0 1 0" range="-2.6 2.6"/>
            <geom type="cylinder" size="0.026 0.03" euler="1.5708 0 0" class="visual" material="accent"/>
            <geom type="capsule" fromto="0 0 0 0.18 0 0" size="0.018" material="link"/>

            <!-- Muñeca, al final del segundo eslabón (18 cm) -->
            <body name="wrist" pos="0.18 0 0">
              <joint name="wrist" axis="0 1 0" range="-2.2 2.2"/>
              <geom type="cylinder" size="0.02 0.025" euler="1.5708 0 0" class="visual" material="accent"/>
              <geom type="capsule" fromto="0 0 0 0.07 0 0" size="0.014" material="dark"/>

              <!-- Punta con la que empuja el cubo, y el site para leer su posición -->
              <geom name="tip" type="sphere" size="0.018" pos="0.08 0 0" material="accent"/>
              <site name="tip" pos="0.08 0 0" size="0.005" rgba="1 1 1 1"/>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ============================ OBJETOS ============================ -->
    <!-- Cubo de 5 cm de lado (size = semilados), libre en 3D. Apoyado en el suelo: z = 0.025 -->
    <body name="cube" pos="0.30 0 0.025">
      <freejoint name="cube"/>
      <geom name="cube" type="box" size="0.025 0.025 0.025" mass="0.08" material="cube"/>
    </body>

    <!-- Zona objetivo: un body "mocap" se mueve desde Python (data.mocap_pos) y no tiene física.
         El disco es visual, así que el cubo puede pasar por encima. -->
    <body name="goal" mocap="true" pos="0.38 0.08 0.001">
      <geom name="goal" type="cylinder" size="0.04 0.001" class="visual" material="goal"/>
    </body>
  </worldbody>

  <!-- ========================== ACTUADORES ========================== -->
  <!-- Un servo por articulación. ctrl = ángulo objetivo, en el mismo rango que el joint. -->
  <actuator>
    <position name="yaw"      joint="yaw"      class="arm" ctrlrange="-2.0 2.0"/>
    <position name="shoulder" joint="shoulder" class="arm" ctrlrange="-1.6 1.6"/>
    <position name="elbow"    joint="elbow"    class="arm" ctrlrange="-2.6 2.6"/>
    <position name="wrist"    joint="wrist"    class="arm" ctrlrange="-2.2 2.2"/>
  </actuator>

  <!-- =========================== POSTURAS =========================== -->
  <!-- "home": brazo recogido con la punta ~11 cm sobre la mesa.
       qpos = [yaw, shoulder, elbow, wrist,  cubo: x y z, cuaternión w x y z]
       ctrl = los mismos ángulos, para que los servos mantengan la postura.
       En el visor: panel izquierdo → Simulation → Key → Load key. -->
  <keyframe>
    <key name="home"
         qpos="0 -0.9 1.8 0.9   0.30 0 0.025  1 0 0 0"
         ctrl="0 -0.9 1.8 0.9"
         mpos="0.38 0.08 0.001"/>
  </keyframe>
</mujoco>
